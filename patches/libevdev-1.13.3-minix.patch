diff -ruN -x '*.orig' -x '*.rej' a/libevdev/libevdev.c b/libevdev/libevdev.c
--- a/libevdev/libevdev.c	2024-09-03 05:00:46.000000000 +0200
+++ b/libevdev/libevdev.c	2026-11-01 17:31:40.191713007 +0200
@@ -1689,9 +1689,24 @@
 		return 0;
 
 	if (grab == LIBEVDEV_GRAB)
+#ifdef __minix
+	{
+		/* MINIX: EVIOCGRAB takes a pointer (see <minix/evdev.h>). */
+		int on = 1;
+		rc = ioctl(dev->fd, EVIOCGRAB, &on);
+	}
+#else
 		rc = ioctl(dev->fd, EVIOCGRAB, (void *)1);
+#endif
 	else if (grab == LIBEVDEV_UNGRAB)
+#ifdef __minix
+	{
+		int off = 0;
+		rc = ioctl(dev->fd, EVIOCGRAB, &off);
+	}
+#else
 		rc = ioctl(dev->fd, EVIOCGRAB, (void *)0);
+#endif
 
 	if (rc == 0)
 		dev->grabbed = grab;
diff -ruN -x '*.orig' -x '*.rej' a/meson.build b/meson.build
--- a/meson.build	2024-09-03 05:00:46.000000000 +0200
+++ b/meson.build	2026-11-01 17:32:04.430650042 +0200
@@ -38,10 +38,12 @@
 # Dependencies
 pkgconfig = import('pkgconfig')
 dep_lm = cc.find_library('m')
-dep_rt = cc.find_library('rt')
+dep_rt = cc.find_library('rt', required : false)	# not on MINIX (in libc)
 
-input_h = dir_root / 'include' / 'linux' / host_machine.system() / 'input.h'
-input_event_codes_h = dir_root / 'include' / 'linux' / host_machine.system() / 'input-event-codes.h'
+# MINIX uses FreeBSD's variant of the kernel headers (see include/linux/minix).
+kernel_headers = host_machine.system() == 'minix' ? 'freebsd' : host_machine.system()
+input_h = dir_root / 'include' / 'linux' / kernel_headers / 'input.h'
+input_event_codes_h = dir_root / 'include' / 'linux' / kernel_headers / 'input-event-codes.h'
 
 # event-names.h
 make_event_names = find_program('libevdev/make-event-names.py')
