diff -ruN -x '*.orig' -x '*.rej' a/include/linux/input.h b/include/linux/input.h
--- a/include/linux/input.h	2024-09-03 05:00:46.000000000 +0200
+++ b/include/linux/input.h	2026-11-01 17:31:40.184488469 +0200
@@ -2,4 +2,6 @@
 #include "linux/input.h"
 #elif __FreeBSD__
 #include "freebsd/input.h"
+#elif defined(__minix)
+#include "minix/input.h"
 #endif
diff -ruN -x '*.orig' -x '*.rej' a/include/linux/minix/input.h b/include/linux/minix/input.h
--- a/include/linux/minix/input.h	1970-01-01 02:00:00.000000000 +0200
+++ b/include/linux/minix/input.h	2026-11-01 17:31:40.184606599 +0200
@@ -0,0 +1,11 @@
+/*
+ * MINIX: the Linux evdev ABI as provided by the input server
+ * (<minix/evdev.h>).  FreeBSD's variant of the kernel header uses the BSD
+ * ioctl encoding MINIX shares; requests with an immediate int argument
+ * (_IOWINT, e.g. EVIOCGRAB) take a pointer to the int on MINIX.
+ */
+#include <sys/ioccom.h>
+#ifndef _IOWINT
+#define _IOWINT(g, n)	_IOW(g, n, int)
+#endif
+#include "../freebsd/input.h"
