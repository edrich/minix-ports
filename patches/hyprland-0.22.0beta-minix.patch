+// MINIX (software rendering): HYPRLAND_MINIX_FRAMESTATS=1 prints, every 5 s,
+// how many frames were rendered, the damage they covered and where the
+// time went (each section ends with glFinish, so softpipe's work is
+// attributed to the section that queued it).  Sections are timed with the
+// TSC, calibrated against the clock over the report window: MINIX clocks
+// tick at 60 Hz, too coarse for single sections.
+#include <x86intrin.h>
+namespace {
+struct SMinixFrameStats {
+    bool     enabled = getenv("HYPRLAND_MINIX_FRAMESTATS") != nullptr;
+    int      frames = 0, skipped = 0, rects = 0;
+    double   damagePx = 0, tClear = 0, tClients = 0, tEnd = 0, tCommit = 0; // TSC cycles
+    std::chrono::steady_clock::time_point last = std::chrono::steady_clock::now();
+    unsigned long long                    lastTsc = __rdtsc(), mark = 0;
+
+    void begin() {
+        mark = __rdtsc();
+    }
+    // TSC cycles since the last section boundary
+    double section(bool finish = true) {
+        if (finish)
+            glFinish();
+        const auto NOW = __rdtsc();
+        const auto C   = (double)(NOW - mark);
+        mark           = NOW;
+        return C;
+    }
+    void damage(pixman_region32_t* rg) {
+        int   n   = 0;
+        auto* box = pixman_region32_rectangles(rg, &n);
+        rects += n;
+        for (int i = 0; i < n; i++)
+            damagePx += (double)(box[i].x2 - box[i].x1) * (box[i].y2 - box[i].y1);
+    }
+    void report() {
+        const auto NOW  = std::chrono::steady_clock::now();
+        const auto SECS = std::chrono::duration<double>(NOW - last).count();
+        if (SECS < 5)
+            return;
+        const int    F    = frames ? frames : 1;
+        const double MSPC = SECS * 1000.0 / (double)(__rdtsc() - lastTsc); // ms per cycle
+        tClear *= MSPC;
+        tClients *= MSPC;
+        tEnd *= MSPC;
+        tCommit *= MSPC;
+        fprintf(stderr, "FRAMESTATS %.1fs frames %d skipped %d rects/frame %.1f damage-kpx/frame %.0f ms/frame clear %.1f clients %.1f end %.1f commit %.1f\n", SECS,
+                frames, skipped, (double)rects / F, damagePx / F / 1000.0, tClear / F, tClients / F, tEnd / F, tCommit / F);
+        *this = SMinixFrameStats();
+    }
+};
+SMinixFrameStats g_minixFrameStats;
+}
