+        {box.x, box.y + box.height - thick, box.width, thick},                 // bottom
+        {box.x, box.y + thick, thick, box.height - 2 * thick},                 // left
+        {box.x + box.width - thick, box.y + thick, thick, box.height - 2 * thick}, // right
