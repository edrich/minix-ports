+++ b/char32.c	2026-11-10 19:05:43.565884522 +0200
@@ -34,7 +34,9 @@
 #if !defined(__STDC_UTF_32__) || !__STDC_UTF_32__
  #error "char32_t does not use UTF-32"
 #endif
-#if (!defined(__STDC_ISO_10646__) || !__STDC_ISO_10646__) && !defined(__FreeBSD__)
