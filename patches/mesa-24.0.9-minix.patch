 /**
+ * MINIX: clear a scissor rectangle (PIPE_CAP_CLEAR_SCISSORED).  The tile
+ * caches are written back and emptied first (sp_flush_tile_cache marks
+ * every tile invalid), then the rectangle is filled in the surfaces
+ * themselves, so later rendering re-reads the cleared pixels.
+ */
+static void
+softpipe_clear_scissored(struct softpipe_context *softpipe, unsigned buffers,
+                         const struct pipe_scissor_state *s,
+                         const union pipe_color_union *color,
+                         double depth, unsigned stencil)
+{
+   struct pipe_context *pipe = &softpipe->pipe;
+   struct pipe_surface *zsbuf = softpipe->framebuffer.zsbuf;
+   unsigned zs_buffers = buffers & PIPE_CLEAR_DEPTHSTENCIL;
+   unsigned w = s->maxx - s->minx, h = s->maxy - s->miny;
+   uint i;
+
+   if (s->minx >= s->maxx || s->miny >= s->maxy)
+      return;
+
+   /* Primitives still queued in the draw module go before the clear. */
+   draw_flush(softpipe->draw);
+
+   if (buffers & PIPE_CLEAR_COLOR) {
+      for (i = 0; i < softpipe->framebuffer.nr_cbufs; i++) {
+         struct pipe_surface *cbuf = softpipe->framebuffer.cbufs[i];
+         if (!(buffers & (PIPE_CLEAR_COLOR0 << i)) || !cbuf)
+            continue;
+         sp_flush_tile_cache(softpipe->cbuf_cache[i]);
+         util_clear_render_target(pipe, cbuf, color, s->minx, s->miny, w, h);
+      }
+   }
+
+   if (zs_buffers && zsbuf) {
+      sp_flush_tile_cache(softpipe->zsbuf_cache);
+      util_clear_depth_stencil(pipe, zsbuf, zs_buffers, depth, stencil,
+                               s->minx, s->miny, w, h);
+   }
+
+   softpipe->dirty_render_cache = true;
+}
+
+
+/**
  * Clear the given buffers to the specified values.
- * No masking, no scissor (clear entire buffer).
+ * No masking; a scissor only with PIPE_CAP_CLEAR_SCISSORED (MINIX).
  */
 void
 softpipe_clear(struct pipe_context *pipe, unsigned buffers,
@@ -64,6 +109,12 @@
    if (!softpipe_check_render_cond(softpipe))
       return;
 
+   if (scissor_state) {
+      softpipe_clear_scissored(softpipe, buffers, scissor_state, color,
+                               depth, stencil);
+      return;
+   }
+
 #if 0
    softpipe_update_derived(softpipe, MESA_PRIM_TRIANGLES); /* not needed?? */
 #endif
