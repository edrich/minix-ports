diff -ruN gcc-13.3.0/gcc/config/i386/minix.h new/gcc/config/i386/minix.h
--- a/gcc/config/i386/minix.h	1970-01-01 02:00:00.000000000 +0200
+++ b/gcc/config/i386/minix.h	2026-11-10 11:34:48.913408320 +0200
@@ -0,0 +1,31 @@
+/* i386 MINIX target definitions: NetBSD-style crt startup files and the
+   MINIX dynamic linker.  */
+
+#undef  LINK_SPEC
+#define LINK_SPEC "  -m elf_i386_minix \
+  %{!static:--eh-frame-hdr} \
+  %{shared:-Bshareable} \
+  %{!shared: \
+    %{!static:-dynamic-linker /usr/libexec/ld.elf_so} \
+    %{static:-Bstatic}}"
+
+/* crt0.o/crti.o/crtn.o ship with MINIX (found in the sysroot); crtbegin/
+   crtend come from this compiler.  */
+#undef  STARTFILE_SPEC
+#define STARTFILE_SPEC "  %{!shared:crt0%O%s} \
+  crti%O%s \
+  %{!shared:crtbegin%O%s} \
+  %{shared:crtbeginS%O%s}"
+
+#undef  ENDFILE_SPEC
+#define ENDFILE_SPEC "  %{!shared:crtend%O%s} \
+  %{shared:crtendS%O%s} \
+  crtn%O%s"
+
+/* Make gcc agree with <machine/ansi.h> (NetBSD-derived).  */
+
+#undef  SIZE_TYPE
+#define SIZE_TYPE "unsigned int"
+
+#undef  PTRDIFF_TYPE
+#define PTRDIFF_TYPE "int"
diff -ruN gcc-13.3.0/gcc/config/minix.h new/gcc/config/minix.h
--- a/gcc/config/minix.h	1970-01-01 02:00:00.000000000 +0200
+++ b/gcc/config/minix.h	2026-11-10 11:34:48.913381540 +0200
@@ -0,0 +1,23 @@
+/* Target definitions for MINIX.  */
+
+#undef  TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()		\
+  do {						\
+    builtin_define ("__minix=3");		\
+    builtin_define ("__minix__=3");		\
+    builtin_define ("__Minix__=3");		\
+    builtin_define_std ("unix");		\
+    builtin_assert ("system=minix");		\
+    builtin_assert ("system=unix");		\
+  } while (0)
+
+/* Everyone links against libc.  -pthread: POSIX threads are libmthread,
+   available as libpthread (see MINIX <pthread.h>).  It is linked even under
+   --as-needed: libgcc's emutls refers to the pthread functions weakly, and
+   weak references alone neither make the library needed nor may stay
+   undefined under --no-undefined when a dependency provides them.  */
+#undef  LIB_SPEC
+#define LIB_SPEC   "%{pthread:--push-state --no-as-needed -lpthread --pop-state} -lc"
+
+#undef  CPP_SPEC
+#define CPP_SPEC "%{pthread:-D_REENTRANT}"
